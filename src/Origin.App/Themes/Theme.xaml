<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:infra="clr-namespace:Origin.Infrastructure"
                    xmlns:controls="clr-namespace:Origin.Controls">

    <!-- ===================================================================== Palette -->

    <Color x:Key="Color.Accent">#FF2FA4FF</Color>
    <Color x:Key="Color.AccentBright">#FF8ED8FF</Color>
    <Color x:Key="Color.Glow">#FF3FB6FF</Color>

    <SolidColorBrush x:Key="Brush.Text" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#C8D7E9FF" />
    <SolidColorBrush x:Key="Brush.TextDim" Color="#80CFE3FF" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentBright" Color="{StaticResource Color.AccentBright}" />
    <SolidColorBrush x:Key="Brush.Panel" Color="#59041838" />
    <SolidColorBrush x:Key="Brush.PanelStrong" Color="#CC03122E" />
    <SolidColorBrush x:Key="Brush.PanelBorder" Color="#3381C8FF" />
    <SolidColorBrush x:Key="Brush.Input" Color="#99020E26" />
    <SolidColorBrush x:Key="Brush.Success" Color="#FF7BE3A8" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#FFFFCB6B" />
    <SolidColorBrush x:Key="Brush.Error" Color="#FFFF8A80" />
    <SolidColorBrush x:Key="Brush.Scrim" Color="#B3000818" />

    <LinearGradientBrush x:Key="Brush.Focus" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF3E9CF0" Offset="0" />
        <GradientStop Color="#FF1E68BF" Offset="0.5" />
        <GradientStop Color="#FF15509C" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.FocusSheen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#55FFFFFF" Offset="0" />
        <GradientStop Color="#18FFFFFF" Offset="0.48" />
        <GradientStop Color="#00FFFFFF" Offset="0.5" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.Selected" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#552E7FD0" Offset="0" />
        <GradientStop Color="#33184E90" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.Banner" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00020A1E" Offset="0" />
        <GradientStop Color="#D9031330" Offset="0.35" />
        <GradientStop Color="#F2020A1E" Offset="1" />
    </LinearGradientBrush>

    <!-- ===================================================================== Type -->

    <FontFamily x:Key="Font.Light">Segoe UI Light, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Regular">Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Semibold">Segoe UI Semibold, Segoe UI</FontFamily>

    <Style x:Key="Text.Hero" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Light}" />
        <Setter Property="FontSize" Value="64" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    </Style>

    <Style x:Key="Text.Heading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Light}" />
        <Setter Property="FontSize" Value="36" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Regular}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Text.Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Regular}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Text.Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Semibold}" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="Margin" Value="2,0,0,8" />
    </Style>

    <!-- ===================================================================== Icons (24 x 24) -->

    <GeometryGroup x:Key="Icon.Origin" FillRule="EvenOdd">
        <EllipseGeometry Center="12,12" RadiusX="11" RadiusY="11" />
        <EllipseGeometry Center="12,12" RadiusX="8" RadiusY="8" />
        <EllipseGeometry Center="12,12" RadiusX="4" RadiusY="4" />
    </GeometryGroup>
    <Geometry x:Key="Icon.Tv">F0 M2,4 L22,4 L22,17 L2,17 Z M4,6 L4,15 L20,15 L20,6 Z M8,19 L16,19 L16,21 L8,21 Z</Geometry>
