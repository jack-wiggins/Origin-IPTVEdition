<nav:OriginPage x:Class="Origin.Views.ChannelGroupsPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:nav="clr-namespace:Origin.Navigation"
                xmlns:controls="clr-namespace:Origin.Controls">
    <nav:OriginPage.Resources>
        <DataTemplate x:Key="GroupRow">
            <Grid Height="46">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="30" Height="30" CornerRadius="3" BorderThickness="2" BorderBrush="{StaticResource Brush.AccentBright}"
                        Background="{Binding BoxBrush}" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Path Data="{StaticResource Icon.Check}" Fill="White" Stretch="Uniform" Margin="4"
                          Visibility="{Binding IsIncluded, Converter={StaticResource BoolToVisibility}}" />
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="23" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding CountText}" FontSize="19" VerticalAlignment="Center" Margin="16,0,4,0"
                           Foreground="{StaticResource Brush.TextSecondary}" />
            </Grid>
        </DataTemplate>
    </nav:OriginPage.Resources>

    <Grid Margin="90,160,90,56">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="600" />
            <ColumnDefinition Width="56" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource Text.Heading}" Text="Choose your channel groups" />
            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,10,0,26"
                       Text="Your provider sorts its channels into groups. Origin copies the ticked groups into your lineup and guide — leave out the countries and categories you don't watch." />

            <TextBlock x:Name="SummaryText" Style="{StaticResource Text.Body}" FontSize="26" />

            <CheckBox x:Name="IncludeNewBox" Margin="-14,22,0,0" Content="Include new groups automatically" />

            <TextBlock Style="{StaticResource Text.Label}" Margin="2,22,0,8" Text="CHANNEL NUMBERS" />
            <controls:ChoiceSpinner x:Name="NumberingSpinner" />

            <StackPanel Orientation="Horizontal" Margin="0,36,0,0">
                <Button Content="select all" Click="OnSelectAll" MinWidth="170" />
                <Button Content="select none" Click="OnSelectNone" MinWidth="170" />
            </StackPanel>
            <Button Content="apply and update lineup" Click="OnApply" HorizontalAlignment="Left" Margin="0,20,0,0" />
        </StackPanel>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBox x:Name="SearchBox" Tag="find a group" TextChanged="OnSearchChanged" Margin="0,0,0,16" />
            <Border Grid.Row="1" Style="{StaticResource Panel.Card}" Padding="8">
                <Grid>
                    <ListBox x:Name="GroupList" Style="{StaticResource List.Origin}" ItemTemplate="{StaticResource GroupRow}"
                             PreviewMouseLeftButtonUp="OnGroupClick" />
                    <TextBlock x:Name="EmptyText" Style="{StaticResource Text.Caption}" FontSize="24" Margin="30" TextAlignment="Center"
                               VerticalAlignment="Center" Visibility="Collapsed"
                               Text="No playlist has been downloaded yet. Set up your IPTV provider, then choose tasks › update lineup." />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</nav:OriginPage>
