<nav:OriginPage x:Class="Origin.Views.ChannelMappingPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:nav="clr-namespace:Origin.Navigation"
                xmlns:controls="clr-namespace:Origin.Controls">
    <nav:OriginPage.Resources>
        <DataTemplate x:Key="MappingRow">
            <Grid Height="58">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92" />
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="5*" />
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="5*" />
                    <ColumnDefinition Width="230" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Number}" FontSize="26" FontFamily="{StaticResource Font.Light}" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Margin="0,0,14,0" />
                <Image Grid.Column="1" Source="{Binding LogoUrl, Converter={StaticResource LogoConverter}}" Width="64" Height="42" Stretch="Uniform" />
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,10,0">
                    <TextBlock Text="{Binding Name}" FontSize="22" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Group}" FontSize="15" Foreground="{StaticResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Path Grid.Column="3" Data="M2,10 H22 M15,3 L22,10 L15,17" Stroke="{StaticResource Brush.TextDim}" StrokeThickness="2"
                      Width="26" Height="18" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />
                <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="10,0,10,0">
                    <TextBlock Text="{Binding StationTitle}" FontSize="22" TextTrimming="CharacterEllipsis" Opacity="{Binding StationOpacity}" />
                    <TextBlock Text="{Binding StationDetail}" FontSize="15" Foreground="{StaticResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Border Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="12,4" CornerRadius="3"
                        Background="{Binding BadgeBrush}">
                    <TextBlock Text="{Binding Badge}" FontSize="15" FontFamily="{StaticResource Font.Semibold}" />
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="PickerRow">
            <StackPanel Margin="0,2">
                <TextBlock Text="{Binding Title}" FontSize="23" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Subtitle}" FontSize="16" Foreground="{StaticResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
    </nav:OriginPage.Resources>

    <Grid>
        <Grid Margin="90,150,90,44">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="380" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="400" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="SummaryText" Style="{StaticResource Text.Body}" FontSize="26" />
                    <TextBlock x:Name="LineupText" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
                </StackPanel>
                <controls:ChoiceSpinner x:Name="FilterSpinner" Grid.Column="1" />
                <TextBox x:Name="SearchBox" Grid.Column="3" Tag="find a channel" TextChanged="OnSearchChanged" />
            </Grid>

            <ListBox x:Name="ChannelList" Grid.Row="1" Style="{StaticResource List.Origin}" ItemTemplate="{StaticResource MappingRow}"
                     MouseDoubleClick="OnChannelDoubleClick" />

            <TextBlock x:Name="EmptyText" Grid.Row="1" Style="{StaticResource Text.Caption}" FontSize="24" HorizontalAlignment="Center"
                       VerticalAlignment="Center" TextAlignment="Center" MaxWidth="900" Visibility="Collapsed" />

            <TextBlock Grid.Row="2" Margin="4,14,0,0" Style="{StaticResource Text.Caption}" FontSize="18" Foreground="{StaticResource Brush.TextDim}"
                       Text="OK  change the match or hide a channel      ‹ ›  filter      Origin keeps your choices when the lineup is updated" />
        </Grid>

        <!-- Station picker -->
        <Grid x:Name="Picker" Visibility="Collapsed" Opacity="0">
            <Rectangle Fill="{StaticResource Brush.Scrim}" MouseLeftButtonUp="OnScrimClick" />
            <Border Width="1180" Height="800" Style="{StaticResource Panel.Card}" Background="{StaticResource Brush.PanelStrong}"
                    BorderBrush="{StaticResource Brush.AccentBright}" Padding="40,32">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="PickerSlide" />
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="PickerTitle" Style="{StaticResource Text.Heading}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        <TextBlock x:Name="PickerSubtitle" Style="{StaticResource Text.Caption}" Margin="0,6,0,20" />
                    </StackPanel>
                    <TextBox x:Name="PickerSearch" Grid.Row="1" Tag="type to search stations by callsign, name or channel"
                             TextChanged="OnPickerSearchChanged" Margin="0,0,0,14" />
                    <ListBox x:Name="PickerList" Grid.Row="2" Style="{StaticResource List.Origin}" ItemTemplate="{StaticResource PickerRow}"
                             PreviewTextInput="OnPickerListTextInput" MouseDoubleClick="OnPickerDoubleClick" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</nav:OriginPage>
