<nav:OriginPage x:Class="Origin.Views.GuidePage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:nav="clr-namespace:Origin.Navigation">
    <nav:OriginPage.Resources>
        <!-- Guide rows: the program cell lights up for the selected channel, as in Media Center. -->
        <Style x:Key="GuideItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Height" Value="80" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="430" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ChannelCell" CornerRadius="4,0,0,4" Background="#4D031330" Margin="0,0,4,0" />
                            <Border x:Name="ProgramCell" Grid.Column="1" CornerRadius="0,4,4,0" Background="#33041838"
                                    BorderBrush="#2281C8FF" BorderThickness="1" />
                            <Border x:Name="Focus" Grid.Column="1" CornerRadius="0,4,4,0" Opacity="0" Background="{StaticResource Brush.Focus}"
                                    BorderBrush="{StaticResource Brush.AccentBright}" BorderThickness="1.5">
                                <Border Background="{StaticResource Brush.FocusSheen}" CornerRadius="0,3,3,0" />
                            </Border>
                            <Border x:Name="ChannelFocus" CornerRadius="4,0,0,4" Margin="0,0,4,0" Opacity="0" Background="{StaticResource Brush.Selected}" />
                            <ContentPresenter Grid.ColumnSpan="2" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Focus" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="ChannelFocus" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Focus" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                            <DoubleAnimation Storyboard.TargetName="ChannelFocus" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="GuideRow">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="104" />
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Number}" FontSize="30" FontFamily="{StaticResource Font.Light}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" />
                <Image Grid.Column="1" Source="{Binding LogoUrl, Converter={StaticResource LogoConverter}}" Width="76" Height="50"
                       Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,14,0">
                    <TextBlock Text="{Binding Name}" FontSize="22" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Callsign}" FontSize="16" Foreground="{StaticResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="26,0,20,0">
                    <TextBlock Text="{Binding ProgramTitle}" FontSize="24" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ProgramDetail}" FontSize="17" Foreground="{StaticResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </nav:OriginPage.Resources>

    <Grid Margin="90,150,90,48">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Time ruler -->
        <Grid Height="52" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="DayText" FontSize="24" FontFamily="{StaticResource Font.Semibold}" VerticalAlignment="Center" Margin="20,0,0,0" />
            <TextBlock x:Name="Slot0" Grid.Column="1" FontSize="24" VerticalAlignment="Center" Margin="26,0,0,0" />
            <TextBlock x:Name="Slot1" Grid.Column="2" FontSize="24" VerticalAlignment="Center" Margin="26,0,0,0" Foreground="{StaticResource Brush.TextSecondary}" />
            <TextBlock x:Name="Slot2" Grid.Column="3" FontSize="24" VerticalAlignment="Center" Margin="26,0,0,0" Foreground="{StaticResource Brush.TextSecondary}" />
            <Rectangle Grid.ColumnSpan="4" Height="1" VerticalAlignment="Bottom" Fill="{StaticResource Brush.PanelBorder}" />
        </Grid>

        <ListBox x:Name="ChannelList" Grid.Row="1" Style="{StaticResource List.Origin}" ItemContainerStyle="{StaticResource GuideItem}"
                 ItemTemplate="{StaticResource GuideRow}" SelectionChanged="OnSelectionChanged"
                 MouseDoubleClick="OnDoubleClick" />

        <!-- Shown while there is nothing to list. -->
        <StackPanel x:Name="EmptyPanel" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="900" Visibility="Collapsed">
            <TextBlock Text="No channels yet" Style="{StaticResource Text.Heading}" HorizontalAlignment="Center" />
            <TextBlock Margin="0,16,0,0" Style="{StaticResource Text.Caption}" TextAlignment="Center" FontSize="24"
                       Text="Add your IPTV provider under settings, then choose tasks › update lineup. Origin will copy your playlist into the guide and match it to Schedules Direct." />
        </StackPanel>

        <!-- Details for the highlighted channel -->
        <Border Grid.Row="2" Margin="0,14,0,0" Padding="28,18" Style="{StaticResource Panel.Card}" x:Name="DetailsPanel">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="DetailTitle" FontSize="30" FontFamily="{StaticResource Font.Light}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="DetailText" Margin="0,4,0,0" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </StackPanel>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource Text.Caption}" FontSize="18"
                           Text="OK  watch     ch+ / ch−  page     0–9  go to channel" Foreground="{StaticResource Brush.TextDim}" />
            </Grid>
        </Border>

        <!-- Direct channel entry -->
        <Border x:Name="NumberEntry" Grid.RowSpan="3" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,0,0"
                Padding="30,10" Style="{StaticResource Panel.Card}" Background="{StaticResource Brush.PanelStrong}" Opacity="0" IsHitTestVisible="False">
            <TextBlock x:Name="NumberText" FontSize="44" FontFamily="{StaticResource Font.Light}" />
        </Border>
    </Grid>
</nav:OriginPage>
