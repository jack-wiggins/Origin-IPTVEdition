<nav:OriginPage x:Class="Origin.Views.GuidePage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:nav="clr-namespace:Origin.Navigation"
                xmlns:controls="clr-namespace:Origin.Controls">
    <nav:OriginPage.Resources>
        <!-- Guide rows: the channel cell lights up for the selected channel, the program block under the time cursor glows, as in Media Center. -->
        <Style x:Key="GuideItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Height" Value="80" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="430" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ChannelCell" CornerRadius="4,0,0,4" Background="#4D031330" Margin="0,0,4,0" />
                            <Border x:Name="ChannelFocus" CornerRadius="4,0,0,4" Margin="0,0,4,0" Opacity="0" Background="{StaticResource Brush.Selected}" />
                            <ContentPresenter Grid.ColumnSpan="2" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ChannelFocus" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ChannelFocus" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A program block. Its width is its share of the 90-minute window. -->
        <DataTemplate x:Key="GuideCell">
            <Border x:Name="Block" Margin="0,0,4,0" CornerRadius="4" Background="#33041838" BorderBrush="#2281C8FF" BorderThickness="1"
                    ClipToBounds="True" PreviewMouseLeftButtonDown="OnCellMouseDown">
                <Grid>
                    <Border x:Name="Focus" CornerRadius="4" Opacity="0" Background="{StaticResource Brush.Focus}"
                            BorderBrush="{StaticResource Brush.AccentBright}" BorderThickness="1.5">
                        <Border Background="{StaticResource Brush.FocusSheen}" CornerRadius="3" />
                    </Border>
                    <Grid Margin="12,0,10,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path x:Name="Before" Data="M7,0 L0,7 L7,14 Z" Fill="{StaticResource Brush.TextSecondary}" Margin="0,0,10,0"
                              VerticalAlignment="Center" Visibility="Collapsed" />
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="Title" Text="{Binding Title}" FontSize="22" TextTrimming="CharacterEllipsis" />
                            <DockPanel LastChildFill="True">
                                <Border x:Name="Badge" DockPanel.Dock="Left" Margin="0,2,8,0" Padding="6,0" CornerRadius="2" VerticalAlignment="Center"
                                        Background="{StaticResource Brush.Accent}">
                                    <TextBlock Text="{Binding Badge}" FontSize="12" FontFamily="{StaticResource Font.Semibold}" />
                                </Border>
                                <TextBlock x:Name="Subtitle" Text="{Binding Subtitle}" FontSize="16" Foreground="{StaticResource Brush.TextSecondary}"
                                           TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </StackPanel>
                        <Path x:Name="After" Grid.Column="2" Data="M0,0 L7,7 L0,14 Z" Fill="{StaticResource Brush.TextSecondary}" Margin="10,0,0,0"
                              VerticalAlignment="Center" Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Badge}" Value="{x:Null}">
                    <Setter TargetName="Badge" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ContinuesBefore}" Value="True">
                    <Setter TargetName="Before" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ContinuesAfter}" Value="True">
                    <Setter TargetName="After" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDim}" Value="True">
                    <Setter TargetName="Block" Property="Background" Value="#1A041838" />
                    <Setter TargetName="Title" Property="Foreground" Value="{StaticResource Brush.TextDim}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Focus" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Focus" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                    <Setter TargetName="Title" Property="Foreground" Value="{StaticResource Brush.Text}" />
                    <Setter TargetName="Subtitle" Property="Foreground" Value="{StaticResource Brush.Text}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="GuideRow">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="104" />
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Number}" FontSize="30" FontFamily="{StaticResource Font.Light}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" />
                <Image Grid.Column="1" Source="{Binding LogoUrl, Converter={StaticResource LogoConverter}}" Width="76" Height="50"
                       Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,14,0">
                    <TextBlock Text="{Binding Name}" FontSize="22" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Callsign}" FontSize="16" Foreground="{StaticResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <ItemsControl Grid.Column="3" ItemsSource="{Binding Cells}" ItemTemplate="{StaticResource GuideCell}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:TimelinePanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="controls:TimelinePanel.Start" Value="{Binding Start}" />
                            <Setter Property="controls:TimelinePanel.End" Value="{Binding End}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
            </Grid>
        </DataTemplate>

        <!-- Small flags in the details panel: NEW, LIVE, HD, TV14 ... -->
        <DataTemplate x:Key="DetailBadge">
            <Border Margin="10,0,0,0" Padding="8,1" CornerRadius="3" BorderThickness="1" BorderBrush="{StaticResource Brush.AccentBright}" VerticalAlignment="Center">
                <TextBlock Text="{Binding}" FontSize="15" FontFamily="{StaticResource Font.Semibold}" Foreground="{StaticResource Brush.AccentBright}" />
            </Border>
        </DataTemplate>
    </nav:OriginPage.Resources>

    <Grid Margin="90,150,90,48">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Time ruler: the 90-minute window, in half hours. -->
        <Grid Height="52" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="DayText" FontSize="24" FontFamily="{StaticResource Font.Semibold}" VerticalAlignment="Center" Margin="20,0,0,0" />
            <TextBlock x:Name="Slot0" Grid.Column="1" FontSize="24" VerticalAlignment="Center" Margin="14,0,0,0" />
            <TextBlock x:Name="Slot1" Grid.Column="2" FontSize="24" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{StaticResource Brush.TextSecondary}" />
            <TextBlock x:Name="Slot2" Grid.Column="3" FontSize="24" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{StaticResource Brush.TextSecondary}" />
            <Rectangle Grid.ColumnSpan="4" Height="1" VerticalAlignment="Bottom" Fill="{StaticResource Brush.PanelBorder}" />
        </Grid>

        <!-- The current time, across the ruler and behind the program blocks so it never covers a title. -->
        <Grid Grid.RowSpan="2" IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:TimelinePanel Grid.Column="1">
                <Rectangle x:Name="NowLine" Width="2" Fill="{StaticResource Brush.AccentBright}" Opacity="0.75" Visibility="Collapsed">
                    <Rectangle.Effect>
                        <DropShadowEffect Color="{StaticResource Color.Glow}" BlurRadius="10" ShadowDepth="0" Opacity="0.9" />
                    </Rectangle.Effect>
                </Rectangle>
            </controls:TimelinePanel>
        </Grid>

        <ListBox x:Name="ChannelList" Grid.Row="1" Style="{StaticResource List.Origin}" ItemContainerStyle="{StaticResource GuideItem}"
                 ItemTemplate="{StaticResource GuideRow}" SelectionChanged="OnSelectionChanged"
                 MouseDoubleClick="OnDoubleClick" />

        <!-- Shown while there is nothing to list. -->
        <StackPanel x:Name="EmptyPanel" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="900" Visibility="Collapsed">
            <TextBlock Text="No channels yet" Style="{StaticResource Text.Heading}" HorizontalAlignment="Center" />
            <TextBlock Margin="0,16,0,0" Style="{StaticResource Text.Caption}" TextAlignment="Center" FontSize="24"
                       Text="Add your IPTV provider under settings, then choose tasks › update lineup. Origin will copy your playlist into the guide and match it to Schedules Direct." />
        </StackPanel>

        <!-- Details for the highlighted program -->
        <Border Grid.Row="2" Margin="0,14,0,0" Padding="28,16" Height="196" Style="{StaticResource Panel.Card}" x:Name="DetailsPanel">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <DockPanel>
                        <ItemsControl x:Name="DetailBadges" DockPanel.Dock="Right" VerticalAlignment="Center" Focusable="False"
                                      ItemTemplate="{StaticResource DetailBadge}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock x:Name="DetailTitle" FontSize="30" FontFamily="{StaticResource Font.Light}" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBlock x:Name="DetailTime" Margin="0,2,0,0" FontSize="20" Foreground="{StaticResource Brush.AccentBright}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="DetailEpisode" Margin="0,2,0,0" FontSize="20" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="DetailText" Margin="0,6,0,0" Style="{StaticResource Text.Caption}" FontSize="19" MaxHeight="52"
                               TextWrapping="Wrap" TextTrimming="WordEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="40,4,0,0" TextElement.FontSize="17" TextElement.Foreground="{StaticResource Brush.TextDim}">
                    <TextBlock Text="OK  watch" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Path Data="M7,0 L0,6 L7,12 Z M11,0 L18,6 L11,12 Z" Fill="{StaticResource Brush.TextDim}" VerticalAlignment="Center" Margin="0,1,8,0" />
                        <TextBlock Text="move through time" />
                    </StackPanel>
                    <TextBlock Text="ch+ / ch−  page" Margin="0,4,0,0" />
                    <TextBlock Text="0–9  go to channel" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Direct channel entry -->
        <Border x:Name="NumberEntry" Grid.RowSpan="3" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,0,0"
                Padding="30,10" Style="{StaticResource Panel.Card}" Background="{StaticResource Brush.PanelStrong}" Opacity="0" IsHitTestVisible="False">
            <TextBlock x:Name="NumberText" FontSize="44" FontFamily="{StaticResource Font.Light}" />
        </Border>
    </Grid>
</nav:OriginPage>
