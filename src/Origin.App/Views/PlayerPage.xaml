<nav:OriginPage x:Class="Origin.Views.PlayerPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:nav="clr-namespace:Origin.Navigation"
                xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF">
    <Grid Background="Black">
        <vlc:VideoView x:Name="Video">
            <!-- VideoView shows its content in a transparent window above the video (video is a native child window). -->
            <Grid x:Name="Overlay" Background="#01000000" TextElement.FontFamily="{StaticResource Font.Regular}"
                  TextElement.Foreground="{StaticResource Brush.Text}">
                <Grid x:Name="OverlayContent">
                    <Grid.LayoutTransform>
                        <ScaleTransform x:Name="OverlayScale" />
                    </Grid.LayoutTransform>

                    <!-- Channel banner -->
                    <Grid x:Name="Banner" VerticalAlignment="Bottom" Height="270" Opacity="0" IsHitTestVisible="False">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="BannerSlide" Y="40" />
                        </Grid.RenderTransform>
                        <Border Background="{StaticResource Brush.Banner}" />
                        <Grid Margin="90,0,90,52" VerticalAlignment="Bottom">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="168" Height="104" CornerRadius="6" Background="#26FFFFFF" BorderBrush="#3381C8FF" BorderThickness="1">
                                <Image x:Name="BannerLogo" Margin="12" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <TextBlock x:Name="BannerNumber" Grid.Column="1" Margin="34,0,30,0" VerticalAlignment="Center"
                                       FontFamily="{StaticResource Font.Light}" FontSize="76" />
                            <!-- What's on now (or the channel name when there are no listings), then what's next. -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock x:Name="BannerName" FontFamily="{StaticResource Font.Light}" FontSize="44" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="BannerDetail" Margin="2,6,0,0" FontSize="22" Foreground="{StaticResource Brush.TextSecondary}"
                                           TextTrimming="CharacterEllipsis" />
                                <Grid x:Name="BannerProgress" Margin="2,12,0,0" Height="4" Width="520" HorizontalAlignment="Left" Visibility="Collapsed">
                                    <Border Background="#33FFFFFF" CornerRadius="2" />
                                    <Border Background="{StaticResource Brush.AccentBright}" CornerRadius="2" RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="BannerProgressScale" ScaleX="0" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="BannerNext" Margin="2,10,0,0" FontSize="20" Foreground="{StaticResource Brush.TextSecondary}"
                                           TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="30,0,0,0">
                                <TextBlock x:Name="BannerClock" FontFamily="{StaticResource Font.Light}" FontSize="38" HorizontalAlignment="Right" />
                                <Border HorizontalAlignment="Right" Margin="0,8,0,0" Padding="12,3" CornerRadius="3" Background="{StaticResource Brush.Accent}">
                                    <TextBlock Text="LIVE" FontFamily="{StaticResource Font.Semibold}" FontSize="16" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Tuning, buffering and error messages -->
                    <Border x:Name="StatusPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40,26" CornerRadius="8"
                            Background="{StaticResource Brush.PanelStrong}" BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="1"
                            Opacity="0" MaxWidth="1100" IsHitTestVisible="False">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="Spinner" Width="40" Height="40" Stretch="Uniform" Stroke="{StaticResource Brush.AccentBright}"
                                  StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M20,2 A18,18 0 1 1 2,20"
                                  RenderTransformOrigin="0.5,0.5" Margin="0,0,24,0" VerticalAlignment="Center">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="SpinnerRotation" />
                                </Path.RenderTransform>
                            </Path>
                            <TextBlock x:Name="StatusText" FontSize="30" FontFamily="{StaticResource Font.Light}" TextWrapping="Wrap"
                                       VerticalAlignment="Center" MaxWidth="960" />
                        </StackPanel>
                    </Border>

                    <!-- Direct channel entry -->
                    <Border x:Name="NumberEntry" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,64,90,0" Padding="34,10"
                            CornerRadius="6" Background="{StaticResource Brush.PanelStrong}" BorderBrush="{StaticResource Brush.PanelBorder}"
                            BorderThickness="1" Opacity="0" IsHitTestVisible="False">
                        <TextBlock x:Name="NumberText" FontFamily="{StaticResource Font.Light}" FontSize="60" />
                    </Border>

                    <Button x:Name="BackButton" Style="{StaticResource Button.Chrome}" Content="{StaticResource Icon.Back}"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="32,26,0,0" Opacity="0" Click="OnBackClick" />
                </Grid>
            </Grid>
        </vlc:VideoView>
    </Grid>
</nav:OriginPage>
