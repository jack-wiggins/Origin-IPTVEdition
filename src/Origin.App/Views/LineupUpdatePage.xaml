<nav:OriginPage x:Class="Origin.Views.LineupUpdatePage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:nav="clr-namespace:Origin.Navigation">
    <Grid Margin="90,150,90,70">
        <!-- Working -->
        <StackPanel x:Name="WorkingPanel" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="1200">
            <Grid Width="120" Height="120" HorizontalAlignment="Center">
                <Ellipse Stroke="{StaticResource Brush.PanelBorder}" StrokeThickness="6" />
                <Path Stroke="{StaticResource Brush.AccentBright}" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M60,3 A57,57 0 0 1 117,60" RenderTransformOrigin="0.5,0.5">
                    <Path.Effect>
                        <DropShadowEffect Color="{StaticResource Color.Glow}" BlurRadius="18" ShadowDepth="0" Opacity="0.9" />
                    </Path.Effect>
                    <Path.RenderTransform>
                        <RotateTransform x:Name="SpinnerRotation" />
                    </Path.RenderTransform>
                    <Path.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="SpinnerRotation" Storyboard.TargetProperty="Angle"
                                                     From="0" To="360" Duration="0:0:1.1" RepeatBehavior="Forever" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Path.Triggers>
                </Path>
            </Grid>
            <TextBlock x:Name="StageText" Margin="0,44,0,0" Style="{StaticResource Text.Heading}" FontSize="44" HorizontalAlignment="Center"
                       TextAlignment="Center" Text="Getting ready…" />
            <TextBlock x:Name="DetailText" Margin="0,14,0,0" Style="{StaticResource Text.Caption}" FontSize="24" HorizontalAlignment="Center"
                       TextAlignment="Center" />
            <TextBlock Margin="0,60,0,0" Style="{StaticResource Text.Caption}" FontSize="19" Foreground="{StaticResource Brush.TextDim}"
                       HorizontalAlignment="Center" Text="Press Back to cancel" />
        </StackPanel>

        <!-- Finished -->
        <Grid x:Name="ResultPanel" Visibility="Collapsed" Opacity="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock x:Name="ResultTitle" Style="{StaticResource Text.Hero}" />
                <TextBlock x:Name="ResultText" Style="{StaticResource Text.Caption}" FontSize="24" Margin="0,10,0,0" />
            </StackPanel>

            <UniformGrid x:Name="StatsGrid" Grid.Row="1" Rows="1" Columns="3" Margin="0,44,0,0" HorizontalAlignment="Left">
                <Border Style="{StaticResource Panel.Card}" Margin="0,0,24,0" Width="340">
                    <StackPanel>
                        <TextBlock x:Name="ChannelsValue" FontFamily="{StaticResource Font.Light}" FontSize="72" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="channels in your lineup" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Panel.Card}" Margin="0,0,24,0" Width="340">
                    <StackPanel>
                        <TextBlock x:Name="MappedValue" FontFamily="{StaticResource Font.Light}" FontSize="72" Foreground="{StaticResource Brush.Success}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="matched to Schedules Direct" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Panel.Card}" Width="340">
                    <StackPanel>
                        <TextBlock x:Name="UnmappedValue" FontFamily="{StaticResource Font.Light}" FontSize="72" Foreground="{StaticResource Brush.Warning}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="without a guide match" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <ItemsControl x:Name="WarningList" Grid.Row="2" Margin="0,36,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Ellipse Width="12" Height="12" Fill="{StaticResource Brush.Warning}" VerticalAlignment="Top" Margin="0,10,16,0" />
                            <TextBlock Text="{Binding}" Style="{StaticResource Text.Body}" MaxWidth="1500" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Grid.Row="3" Orientation="Horizontal">
                <Button x:Name="DoneButton" Content="done" Click="OnDone" />
                <Button x:Name="RetryButton" Content="try again" Click="OnRetry" />
                <Button x:Name="MappingButton" Content="review channel matches" Click="OnReviewMatches" />
                <Button x:Name="GroupsButton" Content="choose channel groups" Click="OnChooseGroups" />
            </StackPanel>
        </Grid>
    </Grid>
</nav:OriginPage>
