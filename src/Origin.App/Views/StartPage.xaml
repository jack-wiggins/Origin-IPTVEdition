<nav:OriginPage x:Class="Origin.Views.StartPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:nav="clr-namespace:Origin.Navigation">
    <Grid>
        <!-- Brand -->
        <StackPanel Orientation="Horizontal" Margin="90,58,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
            <Path Data="{StaticResource Icon.Origin}" Width="46" Height="46" Stretch="Uniform" Fill="{StaticResource Brush.AccentBright}">
                <Path.Effect>
                    <DropShadowEffect Color="{StaticResource Color.Glow}" BlurRadius="22" ShadowDepth="0" Opacity="0.9" />
                </Path.Effect>
            </Path>
            <TextBlock Text="Origin" Margin="18,0,0,4" VerticalAlignment="Center" FontFamily="{StaticResource Font.Light}" FontSize="50" />
        </StackPanel>

        <!-- The menu: categories stacked vertically, the focused one's items laid out to its right. -->
        <Canvas x:Name="MenuCanvas" Margin="0,150,0,120" ClipToBounds="True">
            <!-- Rows further from the focused one fade out towards the edges instead of being cut off. -->
            <Canvas.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="Transparent" Offset="0" />
                    <GradientStop Color="Black" Offset="0.22" />
                    <GradientStop Color="Black" Offset="0.8" />
                    <GradientStop Color="Transparent" Offset="1" />
                </LinearGradientBrush>
            </Canvas.OpacityMask>
            <StackPanel x:Name="RowsPanel">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="RowsOffset" />
                </StackPanel.RenderTransform>
            </StackPanel>
        </Canvas>

        <!-- Status line, e.g. "1,204 channels · 1,031 matched to Schedules Direct". -->
        <TextBlock x:Name="StatusText" Margin="96,0,96,64" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                   Style="{StaticResource Text.Caption}" FontSize="22" />
    </Grid>
</nav:OriginPage>
